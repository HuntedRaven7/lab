{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "rebaseWhen": "never",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track k0s version in build scripts (vX.Y.Z+k0s.N releases)",
      "managerFilePatterns": [
        "/(^|/)build_files/k0s\\.sh$/"
      ],
      "matchStrings": [
        "K0S_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k0sproject/k0s",
      "versioningTemplate": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k0s\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track Helm binary version in build scripts",
      "managerFilePatterns": [
        "/(^|/)build_files/k0s\\.sh$/"
      ],
      "matchStrings": [
        "get-helm-3[\\s\\S]*?--version (?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm"
    },
    {
      "customType": "regex",
      "description": "Track clusteradm (OCM CLI) version in build scripts; pinned <0.11 for KubeStellar",
      "managerFilePatterns": [
        "/(^|/)build_files/k0s\\.sh$/"
      ],
      "matchStrings": [
        "CLUSTERADM_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "open-cluster-management-io/clusteradm",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track default Cilium Helm chart version in homelab-setup",
      "managerFilePatterns": [
        "/(^|/)system_files/.*/usr/libexec/homelab-setup$/"
      ],
      "matchStrings": [
        "HOMELAB_CILIUM_VERSION=\"\\$\\{HOMELAB_CILIUM_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io/"
    },
    {
      "customType": "regex",
      "description": "Track default KubeStellar core chart version in homelab-setup",
      "managerFilePatterns": [
        "/(^|/)system_files/.*/usr/libexec/homelab-setup$/"
      ],
      "matchStrings": [
        "HOMELAB_KUBESTELLAR_VERSION=\"\\$\\{HOMELAB_KUBESTELLAR_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kubestellar/kubestellar/core-chart",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track default KubeStellar Console Helm chart version in homelab-setup",
      "managerFilePatterns": [
        "/(^|/)system_files/.*/usr/libexec/homelab-setup$/"
      ],
      "matchStrings": [
        "HOMELAB_CONSOLE_VERSION=\"\\$\\{HOMELAB_CONSOLE_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "kubestellar-console",
      "registryUrlTemplate": "https://kubestellar.github.io/console"
    }
  ],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ]
    },
    {
      "enabled": false,
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "matchDepTypes": [
        "container"
      ],
      "matchFileNames": [
        ".github/workflows/**.yaml",
        ".github/workflows/**.yml"
      ]
    },
    {
      "description": "clusteradm pinned <0.11 for KubeStellar OCM compatibility",
      "matchDepNames": [
        "open-cluster-management-io/clusteradm"
      ],
      "allowedVersions": "< 0.11"
    }
  ]
}
