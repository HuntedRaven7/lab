[Unit]
Description=Beszel agent
After=local-fs.target

[Container]
Pod=beszel-agent.pod
Image=ghcr.io/henrygd/beszel/beszel-agent:0.21.1@sha256:cb6868012964d7a68debaa2c84bb72285e5f08531e81f506bd4c493bf052e41c
AutoUpdate=registry
Volume=/run/podman/podman.sock:/var/run/docker.sock:ro
Volume=beszel-agent-data:/var/lib/beszel-agent:Z
EnvironmentFile=/etc/homelab/beszel-agent.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
