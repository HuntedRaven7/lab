[Unit]
Description=Glance
After=local-fs.target

[Container]
Pod=glance.pod
Image=docker.io/glanceapp/glance:latest@sha256:bc5a392672c1ec8823c50b61f3bd4b7e5acc34fcbb8477862577b3af1c633875
AutoUpdate=registry
Volume=/etc/homelab/glance/glance.yml:/app/config/glance.yml:ro,Z
Volume=glance-assets:/app/assets:Z
EnvironmentFile=/etc/homelab/glance.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
