[Unit]
Description=Glance
After=local-fs.target

[Container]
Pod=glance.pod
Image=docker.io/glanceapp/glance:latest@sha256:4d7445bc7971836858ffddee5d7501f1efbabb6e694a45b1dde1a789bb1943bb
AutoUpdate=registry
Volume=/etc/homelab/glance/glance.yml:/app/config/glance.yml:ro,Z
Volume=glance-assets:/app/assets:Z
EnvironmentFile=-/etc/homelab/glance.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
