#!/usr/bin/env bash
# Minimal steamos-session-select compatibility for Steam "Switch to Desktop".
# On GDM without relogin automation, best-effort is to end the current session
# so the display manager can present session selection again.
set -euo pipefail

target="${1:-}"

case "${target}" in
    desktop|plasma|gnome|gnome-wayland)
        # Try to shut down Steam cleanly, then terminate the session.
        steam -shutdown >/dev/null 2>&1 || true
        sleep 1
        if [[ -n "${XDG_SESSION_ID:-}" ]] && command -v loginctl >/dev/null 2>&1; then
            loginctl terminate-session "${XDG_SESSION_ID}" >/dev/null 2>&1 || true
        fi
        # Fallback: end user sessions if session termination is unavailable.
        if command -v loginctl >/dev/null 2>&1; then
            loginctl terminate-user "${USER}" >/dev/null 2>&1 || true
        fi
        ;;
    gamescope|steam)
        # Already in/targeting gaming session; no-op.
        exit 0
        ;;
    "")
        echo "Usage: steamos-session-select [desktop|gamescope]" >&2
        exit 2
        ;;
    *)
        echo "steamos-session-select: unknown target '${target}'" >&2
        exit 0
        ;;
esac
