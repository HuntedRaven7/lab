[Unit]
Description=Karakeep Chrome sidecar
After=local-fs.target

[Container]
Pod=karakeep.pod
Image=ghcr.io/karakeep-app/karakeep-chrome:release@sha256:6c80ed470871bb8c129dc58692ca1714cddbc1392faad3ebf59aecd2e6e58eac
AutoUpdate=registry
Exec=--disable-gpu --disable-dev-shm-usage --hide-scrollbars --disable-blink-features=AutomationControlled --window-size=1440,900

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
