[Unit]
Description=Karakeep web
After=local-fs.target

[Container]
Pod=karakeep.pod
Image=ghcr.io/karakeep-app/karakeep:0.34.1@sha256:69ae5315c618b7c14c1af3e34c6e211acdb231793af424ecd1cab0b70691d987
AutoUpdate=registry
Volume=karakeep-data:/data:Z
EnvironmentFile=/etc/homelab/karakeep.env
Environment=MEILI_ADDR=http://127.0.0.1:7700
Environment=BROWSER_WEB_URL=http://127.0.0.1:9222
Environment=DATA_DIR=/data

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
