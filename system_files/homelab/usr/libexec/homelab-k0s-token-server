#!/usr/bin/env python3
# homelab-k0s-token-server: serve the k0s worker join token over HTTP.
#
# Listens on port 6447 and returns the token at GET /token. The token is
# read from /etc/homelab/secrets/k0s-worker-token at runtime; it is never
# baked into the image or committed to the repo. Workers (homelab-1/2) fetch
# it with: curl -fsS http://<control-plane>:6447/token

import http.server
import os
import sys

TOKEN_FILE = "/etc/homelab/secrets/k0s-worker-token"
CONF_FILE = "/etc/homelab/homelab.conf"
PORT = 6447


def conf_value(key: str, default: str = "") -> str:
    """Read a KEY=value pair from homelab.conf (no shell evaluation)."""
    try:
        with open(CONF_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith(f"{key}="):
                    return line.split("=", 1)[1].strip().strip("\"'")
    except FileNotFoundError:
        pass
    return default


# Bind to the LAN API address when known instead of every interface. The token
# endpoint is unauthenticated, so also restrict port 6447 to trusted worker
# addresses at the firewall if your LAN is not trusted.
BIND_ADDR = conf_value("HOMELAB_API_ADDRESS", "0.0.0.0") or "0.0.0.0"


class TokenHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != "/token":
            self.send_error(404)
            return
        if not os.path.isfile(TOKEN_FILE):
            self.send_error(503, "token not ready")
            return
        with open(TOKEN_FILE, "rb") as f:
            token = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(token)))
        self.end_headers()
        self.wfile.write(token)

    def log_message(self, fmt, *args):
        # Keep logs quiet; systemd captures stdout/stderr.
        sys.stdout.write("%s - %s\n" % (self.address_string(), fmt % args))
        sys.stdout.flush()


if __name__ == "__main__":
    server = http.server.ThreadingHTTPServer((BIND_ADDR, PORT), TokenHandler)
    server.serve_forever()
