#!/usr/bin/env bash
# homelab-k0s-join: fetch a worker join token from the control plane and
# write it to /etc/k0s/token so k0sworker.service can start.
#
# Runs on homelab-1/2 (node role). Idempotent: exits if /etc/k0s/token
# already exists. The control plane address and token port come from
# /etc/homelab/homelab.conf.

set -euo pipefail

CONF=/etc/homelab/homelab.conf
TOKEN_FILE=/etc/k0s/token
LOG_TAG=homelab-k0s-join

log() { logger -t "$LOG_TAG" -- "$*"; echo "[homelab-k0s-join] $*"; }
die() { log "FATAL: $*"; exit 1; }

[[ -s "$TOKEN_FILE" ]] && { log "join token already present, nothing to do"; exit 0; }
[[ -f "$CONF" ]] || die "missing $CONF"

# shellcheck disable=SC1090
source "$CONF"

[[ "${HOMELAB_ROLE:-}" == "node" ]] || { log "role is not node, skipping"; exit 0; }

CP_ADDR="${HOMELAB_CONTROL_PLANE:-}"
TOKEN_PORT="${HOMELAB_TOKEN_PORT:-6447}"
[[ -n "$CP_ADDR" ]] || die "HOMELAB_CONTROL_PLANE is not set in $CONF"

mkdir -p /etc/k0s

log "fetching worker join token from http://${CP_ADDR}:${TOKEN_PORT}/token"
until TOKEN="$(curl -fsS --max-time 10 "http://${CP_ADDR}:${TOKEN_PORT}/token")"; do
    log "token not ready, retrying in 10s"
    sleep 10
done

[[ -n "$TOKEN" ]] || die "received empty token"
printf '%s' "$TOKEN" > "${TOKEN_FILE}.tmp"
mv "${TOKEN_FILE}.tmp" "$TOKEN_FILE"
chmod 0600 "$TOKEN_FILE"
log "join token written to $TOKEN_FILE"

# Start the worker now that the token exists. k0sworker.service is gated on
# ConditionPathExists=/etc/k0s/token, so it would not have started earlier.
systemctl start k0sworker.service || log "k0sworker.service start requested; it may still be initializing"
