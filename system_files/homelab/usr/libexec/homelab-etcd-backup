#!/usr/bin/env bash
# Back up k0s cluster state to /var/backups/k0s and keep the newest 7.
# k0s backup includes etcd data and the cluster PKI, and is the recovery path
# when the single control plane (homelab-0) dies.
set -euo pipefail

DEST=/var/backups/k0s
K0S=/usr/local/bin/k0s

mkdir -p "$DEST"
chmod 0700 "$DEST"

# Only run on an active controller.
systemctl is-active --quiet k0scontroller.service || exit 0

"$K0S" backup --save-path "$DEST"

# Keep the 7 most recent backups.
find "$DEST" -maxdepth 1 -type f -name 'k0s_backup_*' -printf '%T@ %p\n' \
    | sort -n \
    | head -n -7 \
    | cut -d' ' -f2- \
    | xargs -r rm -f

echo "k0s backup complete: $(find "$DEST" -maxdepth 1 -type f -name 'k0s_backup_*' | wc -l) backup(s) retained"
