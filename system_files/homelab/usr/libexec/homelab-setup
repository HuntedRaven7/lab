#!/usr/bin/env bash
# homelab-setup: first-boot bootstrap for the control plane (homelab-0).
#
# Runs once after k0scontroller is ready. Installs:
#   - Cilium (CNI + kube-proxy replacement)
#   - KubeStellar core (KubeFlex + ITS + WDS + Postgres)
#   - KubeStellar Console
#   - a worker join token served over HTTP for homelab-1/2
#
# Idempotent: skips steps whose resources already exist. All configuration
# comes from /etc/homelab/homelab.conf (systemd EnvironmentFile). No secrets
# live in the image or the repo: OAuth/JWT/TLS material is generated here at
# runtime and stored under /etc/homelab/secrets/ (mode 0600).

set -euo pipefail

CONF=/etc/homelab/homelab.conf
SECRETS=/etc/homelab/secrets
STAMP=/var/lib/homelab/.setup-done
LOG_TAG=homelab-setup

log()  { logger -t "$LOG_TAG" -- "$*"; echo "[homelab-setup] $*"; }
die()  { log "FATAL: $*"; exit 1; }

[[ -f "$STAMP" ]] && { log "already completed, skipping"; exit 0; }
[[ -f "$CONF" ]]  || die "missing $CONF"

# shellcheck disable=SC1090
source "$CONF"

[[ "${HOMELAB_ROLE:-}" == "control-plane" ]] || { log "role is not control-plane, skipping"; exit 0; }

export KUBECONFIG=/var/lib/k0s/pki/admin.conf
KUBECTL=/usr/local/bin/k0s
HELM=/usr/local/bin/helm

CILIUM_VERSION="${HOMELAB_CILIUM_VERSION:-1.19.4}"
KUBESTELLAR_VERSION="${HOMELAB_KUBESTELLAR_VERSION:-0.30.1}"
CONSOLE_VERSION="${HOMELAB_CONSOLE_VERSION:-0.3.43}"
DOMAIN="${HOMELAB_DOMAIN:-home.arpa}"
METALLB_POOL="${HOMELAB_METALLB_ADDRESSES:-}"

mkdir -p "$SECRETS" /var/lib/homelab
chmod 0700 "$SECRETS"

# --- wait for k0s API -------------------------------------------------------
log "waiting for k0s API"
until $KUBECTL kubectl get --raw='/readyz' >/dev/null 2>&1; do
    sleep 5
done
log "k0s API ready"

# --- Cilium (CNI + kube-proxy replacement) ----------------------------------
# k0s is configured with network.provider=custom and kubeProxy.disabled=true,
# so Cilium must replace kube-proxy and provide the CNI.
API_ADDR="${HOMELAB_API_ADDRESS:-$(hostname -I | awk '{print $1}')}"
if $HELM status cilium -n kube-system >/dev/null 2>&1; then
    log "Cilium already installed, skipping"
else
    log "installing Cilium ${CILIUM_VERSION}"
    $HELM repo add cilium https://helm.cilium.io/ >/dev/null 2>&1 || true
    $HELM repo update cilium >/dev/null 2>&1
    $HELM upgrade --install cilium cilium/cilium \
        --version "${CILIUM_VERSION}" \
        --namespace kube-system \
        --set kubeProxyReplacement=true \
        --set k8sServiceHost="${API_ADDR}" \
        --set k8sServicePort=6443 \
        --set ipam.mode=kubernetes \
        --set hubble.enabled=true \
        --set hubble.relay.enabled=true \
        --set hubble.ui.enabled=true \
        --wait --timeout 10m
    log "Cilium installed"
fi

# --- MetalLB (LoadBalancer for Console and add-on routes) -------------------
if $HELM status metallb -n metallb-system >/dev/null 2>&1; then
    log "MetalLB already installed, skipping"
else
    log "installing MetalLB"
    $HELM repo add metallb https://metallb.github.io/metallb >/dev/null 2>&1 || true
    $HELM repo update metallb >/dev/null 2>&1
    $HELM upgrade --install metallb metallb/metallb \
        --namespace metallb-system --create-namespace \
        --wait --timeout 5m
    log "MetalLB installed"
fi

if [[ -n "$METALLB_POOL" ]]; then
    log "applying MetalLB address pool: $METALLB_POOL"
    $KUBECTL kubectl apply -f - <<EOF
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: homelab-pool
  namespace: metallb-system
spec:
  addresses:
  - "${METALLB_POOL}"
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: homelab-l2
  namespace: metallb-system
spec:
  ipAddressPools:
  - homelab-pool
EOF
else
    log "HOMELAB_METALLB_ADDRESSES not set; skipping MetalLB pool (LoadBalancers will stay Pending)"
fi

# --- KubeStellar core (KubeFlex + ITS + WDS + Postgres) ---------------------
# Full KubeStellar: the core chart installs KubeFlex and the PostCreateHooks
# that bring up the ITS/WDS control planes. clusteradm (v0.10.1) is used later
# by the Console / operator workflows to register WECs.
if $HELM status ks-core -n default >/dev/null 2>&1; then
    log "KubeStellar core already installed, skipping"
else
    log "installing KubeStellar core ${KUBESTELLAR_VERSION}"
    $HELM upgrade --install ks-core \
        oci://ghcr.io/kubestellar/kubestellar/core-chart \
        --version "${KUBESTELLAR_VERSION}" \
        --set-json='ITSes=[{"name":"its1"}]' \
        --set-json='WDSes=[{"name":"wds1"}]' \
        --set-json='verbosity.default=5' \
        --set-json='kubeflex-operator.verbosity=5' \
        --timeout 24h --wait
    log "KubeStellar core installed"
fi

# --- KubeStellar Console ----------------------------------------------------
# The Console chart auto-generates a JWT secret and falls back to demo/admin
# sign-in when no GitHub OAuth is configured. Secrets are never committed:
# optional GitHub OAuth values come from homelab.conf (operator-supplied).
if $HELM status kc -n kubestellar-console >/dev/null 2>&1; then
    log "KubeStellar Console already installed, skipping"
else
    log "installing KubeStellar Console ${CONSOLE_VERSION}"
    $HELM repo add kubestellar-console https://kubestellar.github.io/console >/dev/null 2>&1 || true
    $HELM repo update kubestellar-console >/dev/null 2>&1

    CONSOLE_ARGS=(
        --namespace kubestellar-console --create-namespace
        --version "${CONSOLE_VERSION}"
        --wait --timeout 10m
    )
    if [[ -n "${HOMELAB_CONSOLE_GITHUB_CLIENT_ID:-}" && -n "${HOMELAB_CONSOLE_GITHUB_CLIENT_SECRET:-}" ]]; then
        CONSOLE_ARGS+=(--set "github.clientId=${HOMELAB_CONSOLE_GITHUB_CLIENT_ID}")
        CONSOLE_ARGS+=(--set "github.clientSecret=${HOMELAB_CONSOLE_GITHUB_CLIENT_SECRET}")
        [[ -n "${HOMELAB_CONSOLE_ALLOWED_LOGINS:-}" ]] && CONSOLE_ARGS+=(--set "auth.allowedGitHubLogins=${HOMELAB_CONSOLE_ALLOWED_LOGINS}")
        [[ -n "${HOMELAB_CONSOLE_ADMIN_LOGINS:-}" ]] && CONSOLE_ARGS+=(--set "auth.adminGitHubLogins=${HOMELAB_CONSOLE_ADMIN_LOGINS}")
    fi

    $HELM upgrade --install kc kubestellar-console/kubestellar-console "${CONSOLE_ARGS[@]}"
    log "KubeStellar Console installed (access: kubectl -n kubestellar-console port-forward svc/kc-kubestellar-console 8080:8080)"
fi

# --- worker join token ------------------------------------------------------
# Generate a worker join token once and keep it under /etc/homelab/secrets/ so
# the token service can serve it to homelab-1/2. The token embeds the API
# server URL; rewrite localhost to the control plane's real address so workers
# can reach it. The token is never written to the image or the repo.
TOKEN_FILE="${SECRETS}/k0s-worker-token"
if [[ ! -s "$TOKEN_FILE" ]]; then
    log "generating k0s worker join token"
    RAW_TOKEN=$(/usr/local/bin/k0s token create --role=worker --expiry=8760h)
    # Tokens are base64-encoded kubeconfigs; replace localhost/127.0.0.1 with
    # the control plane address so remote workers can join.
    FIXED_TOKEN=$(printf '%s' "$RAW_TOKEN" | base64 -d 2>/dev/null \
        | sed "s|https://127.0.0.1:6443|https://${API_ADDR}:6443|g; s|https://localhost:6443|https://${API_ADDR}:6443|g" \
        | base64 -w0 2>/dev/null || printf '%s' "$RAW_TOKEN")
    printf '%s' "$FIXED_TOKEN" > "${TOKEN_FILE}.tmp"
    mv "${TOKEN_FILE}.tmp" "$TOKEN_FILE"
    chmod 0600 "$TOKEN_FILE"
    log "worker join token written to ${TOKEN_FILE} (API ${API_ADDR}:6443)"
else
    log "worker join token already exists, skipping"
fi

touch "$STAMP"
log "setup complete"