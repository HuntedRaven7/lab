#!/usr/bin/env bash
# Fetch a kubeadm join command from the control plane and join this worker.
# Control plane endpoint is read from /etc/kubernetes/node.env (CONTROL_PLANE,
# TOKEN_PORT). Optional JOIN_TOKEN can be set in node.env or
# /etc/kubernetes/join-server.token to authenticate to a hardened join server.
# Idempotent: exits if this node already joined.

set -euo pipefail

JOIN_MARKER=/etc/kubernetes/kubelet.conf
NODE_ENV=/etc/kubernetes/node.env
JOIN_TOKEN_FILE=/etc/kubernetes/join-server.token
LOG_TAG=k8s-worker-join

log() { logger -t "$LOG_TAG" -- "$*"; echo "[$LOG_TAG] $*"; }
die() { log "FATAL: $*"; exit 1; }

[[ -s "$JOIN_MARKER" ]] && { log "node already joined, nothing to do"; exit 0; }
[[ -f "$NODE_ENV" ]] || die "missing $NODE_ENV"

# shellcheck disable=SC1090
source "$NODE_ENV"

CP_ADDR="${CONTROL_PLANE:-}"
TOKEN_PORT="${TOKEN_PORT:-6447}"
JOIN_TOKEN="${JOIN_TOKEN:-}"
[[ -n "$CP_ADDR" ]] || die "CONTROL_PLANE is not set in $NODE_ENV"

if [[ -z "$JOIN_TOKEN" && -s "$JOIN_TOKEN_FILE" ]]; then
    JOIN_TOKEN="$(tr -d '[:space:]' < "$JOIN_TOKEN_FILE")"
fi

mkdir -p /etc/kubernetes

URL="http://${CP_ADDR}:${TOKEN_PORT}/join"
log "fetching join command from ${URL}"
until if [[ -n "$JOIN_TOKEN" ]]; then
        JOIN_CMD="$(curl -fsS --max-time 10 -H "Authorization: Bearer ${JOIN_TOKEN}" "$URL")"
      else
        JOIN_CMD="$(curl -fsS --max-time 10 "$URL")"
      fi; do
    log "join command not ready, retrying in 10s"
    sleep 10
done

[[ -n "$JOIN_CMD" ]] || die "received empty join command"

log "running kubeadm join"
eval "$JOIN_CMD"
log "worker joined cluster"

