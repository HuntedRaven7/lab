[Unit]
Description=k0s controller (zero friction Kubernetes)
Documentation=https://k0sproject.io
After=network-online.target
Wants=network-online.target
# Controller unless a join token is present (see k0sworker.service).
ConditionPathExists=!/etc/k0s/token

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=-/etc/sysconfig/k0s
ExecStart=/usr/local/bin/k0s controller -c /etc/k0s/k0s.yaml $K0S_CONTROLLER_ARGS
Restart=on-failure
StartLimitInterval=5
StartLimitBurst=10
TimeoutStartSec=300
RestartSec=15
LimitNOFILE=65535
KillMode=process

[Install]
WantedBy=multi-user.target