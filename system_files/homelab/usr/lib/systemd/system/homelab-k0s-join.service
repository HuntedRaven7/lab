[Unit]
Description=Fetch k0s worker join token from the control plane
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/k0s/token

[Service]
Type=oneshot
ExecStart=/usr/libexec/homelab-k0s-join
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
StartLimitInterval=0

[Install]
WantedBy=multi-user.target