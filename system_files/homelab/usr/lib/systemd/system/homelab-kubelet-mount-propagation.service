[Unit]
Description=Make /var/lib/kubelet a shared mount (CSI volume propagation)
Documentation=https://kubernetes.io/docs/concepts/storage/volumes/#mount-propagation
After=local-fs.target
Before=k0scontroller.service k0sworker.service
ConditionPathIsDirectory=/var/lib/kubelet

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/homelab-kubelet-mount-propagation

[Install]
WantedBy=multi-user.target
