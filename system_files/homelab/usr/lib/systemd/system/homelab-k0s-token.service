[Unit]
Description=Serve k0s worker join token for homelab nodes
After=k0scontroller.service network-online.target
Wants=k0scontroller.service network-online.target

[Service]
Type=simple
# The token generator waits up to 10 minutes for the local API.
TimeoutStartSec=15min
ExecStartPre=/usr/libexec/homelab-k0s-token
ExecStart=/usr/libexec/homelab-k0s-token-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target