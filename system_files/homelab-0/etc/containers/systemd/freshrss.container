[Unit]
Description=FreshRSS
After=local-fs.target

[Container]
Pod=freshrss.pod
Image=lscr.io/linuxserver/freshrss:1.30.4@sha256:8b18490112cafc5f6e113ceeb4fe2228fb267a9700aa57ee8392da636c596a88
AutoUpdate=registry
Volume=freshrss-config:/config:Z
EnvironmentFile=-/etc/homelab/freshrss.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
