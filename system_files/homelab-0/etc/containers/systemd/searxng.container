[Unit]
Description=SearXNG
After=local-fs.target

[Container]
Pod=searxng.pod
Image=docker.io/searxng/searxng:2026.11.2-cccbc9e15@sha256:892ed5710603e38f9dc201e6a0b2f3f14dbdb8108edcadac30e55b165c979fb7
AutoUpdate=registry
Volume=searxng-config:/etc/searxng:Z
Volume=searxng-data:/var/cache/searxng:Z
EnvironmentFile=-/etc/homelab/searxng.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
