[Unit]
Description=Caddy HTTPS reverse proxy for Vaultwarden
After=local-fs.target

[Container]
Pod=vaultwarden.pod
Image=docker.io/library/caddy:2.11.8-alpine@sha256:f6228111e5fafa1a5238258d0858e103f10599b8d1659a146e7726681a002bb9
AutoUpdate=registry
Volume=/etc/homelab/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data:/data:Z
Volume=caddy-config:/config:Z
EnvironmentFile=-/etc/homelab/caddy.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
