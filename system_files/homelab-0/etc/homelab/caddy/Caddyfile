# /etc/homelab/caddy/Caddyfile (EXAMPLE for Vaultwarden HTTPS)
# Caddy terminates HTTPS in the vaultwarden pod and proxies to Vaultwarden on localhost:80.
# Replace the site address and TLS configuration for your environment.

{
	# admin off
}

:443 {
	# EXAMPLE: use internal TLS for Tailnet/private use, or configure ACME/DNS.
	tls internal

	encode gzip

	reverse_proxy 127.0.0.1:80 {
		header_up X-Real-IP {remote_host}
	}
}
